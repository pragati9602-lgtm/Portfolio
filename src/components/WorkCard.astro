---
import Reveal from './Reveal.astro';
import type { WorkItem } from '../data/work';

interface Props {
  item: WorkItem;
  index: number;
}

const { item, index } = Astro.props;
const id = `work-${item.slug}`;
// TODO: link to `/work/${item.slug}` once case study pages exist (BRIEF.md §10 Phase 4)
const href = '/work';
---

<article class="card" style={`--tilt: ${index % 2 ? 0.8 : -0.8}deg`}>
  <div class="card__media">
    <Reveal
      id={id}
      top={{ src: item.final }}
      bottom={{ src: item.process }}
      alt={item.alt}
      width={800}
      height={600}
      sizes="(min-width: 60rem) 33vw, 92vw"
      cursor="peek"
      brush={0.13}
      resteepDelay={500}
      resteepDuration={900}
    />
    <button class="card__toggle" data-reveal-toggle={id} aria-pressed="false">
      <span class="card__toggle-off">Peek at the process</span>
      <span class="card__toggle-on">Back to the final</span>
    </button>
  </div>
  <div class="card__body">
    <p class="card__meta">
      <span>{item.tags.join(' · ')}</span>
      <span>{item.year}</span>
    </p>
    <h3 class="card__title"><a href={href}>{item.title}</a></h3>
    <p class="card__summary">{item.summary}</p>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .card__media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow: var(--shadow-paper);
    transform: rotate(var(--tilt));
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }

  .card:hover .card__media {
    transform: rotate(0deg) translateY(-4px);
  }

  .card__toggle {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.5em 0.95em;
    border: 0;
    border-radius: 999px;
    background: rgb(250 245 236 / 0.92);
    color: var(--ink);
    font: 600 0.8rem / 1 var(--font-body);
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 2px 10px rgb(42 28 18 / 0.12);
  }

  /* fine pointers can hover; show the button only to keyboard users */
  @media (hover: hover) and (pointer: fine) {
    .card__toggle:not(:focus-visible):not([aria-pressed='true']) {
      opacity: 0;
      pointer-events: none;
    }
  }

  .card__toggle-on,
  .card__toggle[aria-pressed='true'] .card__toggle-off {
    display: none;
  }

  .card__toggle[aria-pressed='true'] .card__toggle-on {
    display: inline;
  }

  .card__body {
    display: grid;
    gap: 0.4rem;
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--step--1);
    color: var(--ink-soft);
    letter-spacing: 0.03em;
  }

  .card__title {
    font-size: var(--step-2);
  }

  .card__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--pulp), var(--pulp));
    background-size: 0% 0.35em;
    background-position: 0 88%;
    background-repeat: no-repeat;
    transition: background-size 0.45s var(--ease-out);
  }

  .card__title a:hover,
  .card__title a:focus-visible {
    background-size: 100% 0.35em;
  }

  .card__summary {
    color: var(--ink-soft);
  }
</style>
